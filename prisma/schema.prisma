generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) email String @unique name String? leads Lead[] createdAt DateTime @default(now()) }
model Lead { id String @id @default(cuid()) name String company String? email String? score Int @default(0) userId String user User @relation(fields:[userId], references:[id]) createdAt DateTime @default(now()) }
